# Option 1 (Recommended): Gemini Developer API key from Google AI Studio
# Get an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Accepted alias for GEMINI_API_KEY (used if GEMINI_API_KEY is not set)
# GOOGLE_API_KEY=your_api_key_here

# Optional: Gemini model ID (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Option 2 (Alternative): Google Cloud Vertex AI
# Authenticate with `gcloud auth application-default login`, then uncomment:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional: Custom .env file path (set to "" to disable automatic .env loading)
# MEMORY_GUARD_DOTENV_PATH=
